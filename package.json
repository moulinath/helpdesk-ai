    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
