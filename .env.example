# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string. Local dev (see README / sprint-plan item 0):
#   postgresql://helpdesk:helpdesk@localhost:5432/helpdesk_dev
# Production and previews: the Neon connection string (set in Vercel, not here).
DATABASE_URL=

# Direct (non-pooled) connection for Prisma migrations. Neon only; leave blank locally.
DIRECT_URL=

# Integration tests only. Must name a *_test database. Defaults to the local test database.
DATABASE_URL_TEST=

# Anthropic API key (US-03). Use a separate key with its own spend limit for dev and /eval.
ANTHROPIC_API_KEY=

# Auth.js session secret (US-12). Generate with: npx auth secret (writes it into .env.local).
AUTH_SECRET=

# Auth.js: trust the Host header. Needed for `next start` locally and in CI; Vercel sets it itself.
AUTH_TRUST_HOST=true

# Show the demo accounts on the sign-in page (S4). Only on the public demo.
DEMO_MODE=false

# Demo account passwords for `npm run db:seed` (US-12 AC5). Public by design (RAID R19).
# Leave blank to use the documented defaults in src/lib/demo-accounts.ts.
DEMO_AGENT_PASSWORD=
DEMO_LEAD_PASSWORD=

# Secret for HMAC rate-limit keys (US-01). Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=

# Bearer secret Vercel cron sends to /api/cron/retention (NFR-15).
CRON_SECRET=

# Daily AI spend cap in US dollars, triage and Ask the KB together (US-09, architecture §6.6).
AI_DAILY_BUDGET_USD=0.15

# Sentry DSN (error reporting; added with the first story that needs it).
SENTRY_DSN=

# Turn AI triage off: new tickets go straight to "Needs triage" (US-09).
AI_TRIAGE_ENABLED=true
